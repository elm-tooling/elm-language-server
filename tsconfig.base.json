{
  "compilerOptions": {
    "noEmit": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "strict": true,
    "lib": ["ES2022"],
    "sourceMap": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "composite": true,
    "typeRoots": ["./src/typings", "./node_modules/@types"]
  },
  "exclude": ["node_modules"]
}
