{
  "name": "@elm-tooling/elm-language-server",
  "description": "Implementation of an elm language server in node.",
  "version": "2.8.0",
  "author": "Kolja Lampe",
  "license": "MIT",
  "type": "module",
  "main": "./out/module.js",
  "files": [
    "out"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elm-tooling/elm-language-server"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "escape-string-regexp": "^5.0.0",
    "execa": "^5.1.1",
    "fast-diff": "^1.3.0",
    "reflect-metadata": "^0.2.2",
    "request-light": "^0.8.0",
    "ts-debounce": "^4.0.0",
    "tsyringe": "^4.10.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-uri": "^3.1.0",
    "web-tree-sitter": "0.26.12"
  },
  "devDependencies": {
    "@elm-tooling/tree-sitter-elm": "5.9.4",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "doctoc": "^2.5.0",
    "elm-format": "^0.8.8",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "jest-diff": "^30.4.1",
    "jest-mock-extended": "^4.0.1",
    "node-gyp": "^12.4.0",
    "prettier": "^3.9.6",
    "tree-sitter-cli": "0.26.12",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "version-patch": "npm --no-git-tag-version version patch",
    "version-minor": "npm --no-git-tag-version version minor",
    "version-major": "npm --no-git-tag-version version major",
    "version": "npm i && npm run compile",
    "clean": "node --input-type=module -e \"import fs from 'node:fs';fs.rmSync('out',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "copy-wasm": "node --input-type=module -e \"import fs from 'node:fs';fs.mkdirSync('out',{recursive:true});fs.copyFileSync('tree-sitter-elm.wasm','out/tree-sitter-elm.wasm')\"",
    "compile": "npm run clean && npm run copy-wasm && tsc -p ./",
    "watch": "npm run copy-wasm && tsc -watch -p ./",
    "typecheck": "tsc --build tsconfig.node.json tsconfig.browser.json --pretty false",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"script/**/*.mjs\" \"*.{js,json,mjs,yaml}\" \".github/workflows/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"script/**/*.mjs\" \"*.{js,json,mjs,yaml}\" \".github/workflows/*.{yml,yaml}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "build-tree-sitter": "tree-sitter build --wasm ./node_modules/@elm-tooling/tree-sitter-elm",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:package": "npm run compile && node script/package-smoke.mjs",
    "generate-toc": "doctoc README.md"
  },
  "bin": {
    "elm-language-server": "out/node/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "elm",
    "elm-lang",
    "language server",
    "language-server",
    "lsp"
  ]
}
